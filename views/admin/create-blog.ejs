<div class="min-h-screen bg-gray-50 flex items-center justify-center py-10 px-4">
  <div class="w-full max-w-2xl bg-white shadow-lg rounded-xl p-8">

    <h2 class="text-2xl font-semibold text-gray-800 mb-6 border-b pb-2">
      ✍️ Create Blog Post
    </h2>

    <form id="blogForm" enctype="multipart/form-data" class="space-y-5">

      <!-- Title -->
      <div>
        <label class="block text-gray-700 font-medium mb-1">Title</label>
        <input
          type="text"
          name="title"
          class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500"
          required
        />
      </div>

      <!-- Slug -->
      <div>
        <label class="block text-gray-700 font-medium mb-1">Slug (optional)</label>
        <input
          type="text"
          name="slug"
          class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500"
        />
        <p class="text-sm text-gray-500 mt-1">
          Leave empty to auto-generate from title.
        </p>
      </div>

      <!-- Category -->
      <div>
        <label class="block text-gray-700 font-medium mb-1">Category</label>

        <div class="flex gap-3">
          <select
            name="category"
            id="categorySelect"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500"
            required
          >
            <option value="">Loading categories...</option>
          </select>

          <!-- Add Category Button -->
          <button
            type="button"
            id="newCategoryBtn"
            class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700"
          >
            +
          </button>
        </div>

        <p class="text-sm text-gray-500 mt-1">
          Select a category or create a new one.
        </p>
      </div>

      <!-- Content -->
      <div>
        <label class="block text-gray-700 font-medium mb-1">Content</label>
        <textarea
          name="content"
          rows="6"
          class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500"
          required
        ></textarea>
      </div>

      <!-- Image Upload -->
      <div>
        <label class="block text-gray-700 font-medium mb-1">Featured Image</label>
        <input
          type="file"
          name="image"
          accept="image/*"
          class="block w-full text-sm"
        />
        <p class="text-sm text-gray-500 mt-1">Max 10MB.</p>
      </div>

      <!-- PDF Upload -->
      <div>
        <label class="block text-gray-700 font-medium mb-1">Upload PDF</label>
        <input type="file" name="pdf" accept=".pdf" class="block w-full text-sm" />
        <p class="text-sm text-gray-500 mt-1">Max 50MB.</p>
      </div>

      <!-- ZIP Upload -->
      <div>
        <label class="block text-gray-700 font-medium mb-1">Upload ZIP</label>
        <input type="file" name="zip" accept=".zip" class="block w-full text-sm" />
        <p class="text-sm text-gray-500 mt-1">Max 50MB.</p>
      </div>

      <!-- Status -->
      <div>
        <label class="block text-gray-700 font-medium mb-1">Status</label>
        <select
          name="status"
          class="w-full border border-gray-300 rounded-lg px-4 py-2"
          required
        >
          <option value="draft">Draft</option>
          <option value="published">Published</option>
        </select>
      </div>

      <!-- Submit -->
      <button
        type="submit"
        id="submitBtn"
        class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-2 rounded-lg"
      >
        Publish Blog
      </button>

    </form>

    <div id="message" class="mt-5"></div>

  </div>
</div>

<!-- CATEGORY MODAL -->
<div
  id="categoryModal"
  class="fixed inset-0 bg-black/40 flex items-center justify-center hidden"
>
  <div class="bg-white rounded-xl p-6 w-full max-w-sm shadow-xl">

    <h3 class="text-xl font-semibold mb-3">Create New Category</h3>

    <input
      type="text"
      id="newCategoryInput"
      class="w-full border border-gray-300 rounded-lg px-4 py-2 mb-3"
      placeholder="Category name"
    />

    <div class="flex justify-end gap-3 mt-4">
      <button
        id="closeCategoryModal"
        class="px-4 py-2 bg-gray-300 rounded-lg hover:bg-gray-400"
      >
        Cancel
      </button>
      <button
        id="saveCategoryBtn"
        class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700"
      >
        Save
      </button>
    </div>

  </div>
</div>

<script>
  // =====================================================
  // Load Categories
  // =====================================================
  async function loadCategories() {
    try {
      const res = await fetch("/api/admin/post-category");
      const data = await res.json();

      const select = document.getElementById("categorySelect");
      select.innerHTML = "";

      if (!data.success || data.categories.length === 0) {
        select.innerHTML = `<option value="">No categories yet</option>`;
        return;
      }

      data.categories.forEach((cat) => {
        const option = document.createElement("option");
        option.value = cat._id;
        option.textContent = cat.name;
        select.appendChild(option);
      });
    } catch (err) {
      console.error("Error loading categories:", err);
    }
  }

  window.addEventListener("DOMContentLoaded", loadCategories);

  // =====================================================
  // Category Modal Controls
  // =====================================================
  const modal = document.getElementById("categoryModal");
  const newCategoryBtn = document.getElementById("newCategoryBtn");
  const saveCategoryBtn = document.getElementById("saveCategoryBtn");
  const closeCategoryModal = document.getElementById("closeCategoryModal");

  newCategoryBtn.addEventListener("click", () => {
    modal.classList.remove("hidden");
  });

  closeCategoryModal.addEventListener("click", () => {
    modal.classList.add("hidden");
  });

  // =====================================================
  // Create Category
  // =====================================================
  saveCategoryBtn.addEventListener("click", async () => {
    const input = document.getElementById("newCategoryInput");
    const name = input.value.trim();

    if (!name) {
      alert("Category name cannot be empty.");
      return;
    }

    try {
      const res = await fetch("/api/admin/post-category", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name }),
      });

      const data = await res.json();

      if (data.success) {
        // Reload categories
        await loadCategories();

        // Auto-select new one
        const select = document.getElementById("categorySelect");
        select.value = data.category._id;

        modal.classList.add("hidden");
        input.value = "";
      } else {
        alert(data.message || "Error creating category");
      }
    } catch (err) {
      console.error("Error creating category:", err);
    }
  });

  // =====================================================
  // Blog Submit Logic
  // =====================================================
  const form = document.getElementById("blogForm");
  const messageDiv = document.getElementById("message");
  const submitBtn = document.getElementById("submitBtn");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    submitBtn.disabled = true;
    submitBtn.textContent = "Publishing...";

    const formData = new FormData(form);

    try {
      const res = await fetch("/api/admin/posts", {
        method: "POST",
        body: formData,
      });

      const data = await res.json();

      if (res.ok) {
        messageDiv.innerHTML = `<div class="bg-green-100 text-green-700 p-3 rounded">✔ ${data.message}</div>`;
        form.reset();
        setTimeout(() => (window.location.href = "/api/admin/posts"), 1500);
      } else {
        messageDiv.innerHTML = `<div class="bg-red-100 text-red-700 p-3 rounded">✖ ${data.message}</div>`;
      }
    } catch (err) {
      messageDiv.innerHTML =
        `<div class="bg-yellow-100 text-yellow-800 p-3 rounded">⚠ Error: ${err.message}</div>`;
    }

    submitBtn.disabled = false;
    submitBtn.textContent = "Publish Blog";
  });
</script>
