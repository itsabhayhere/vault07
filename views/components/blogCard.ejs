<!-- BLOG ROW CARD (Dark Theme) -->
<div class="w-full bg-[#0F1B33] border border-slate-800 rounded-2xl p-6 md:p-8 
            flex flex-col md:flex-row md:items-center gap-8 shadow-lg 
            hover:shadow-slate-500/20 transition-all duration-300 mx-auto">

  <!-- Left: Text -->
  <div class="flex-1 space-y-4">

    <!-- Category Badge -->
    <div class="text-slate-400 text-sm flex items-center gap-2">
      <a href="/api/category/<%= post.category?.slug %>"
         class="px-3 py-1 bg-slate-800 text-cyan-300 rounded-full text-xs
                hover:bg-slate-700 transition">
        <%= post.category?.name || 'Uncategorized' %>
      </a>
    </div>
    <!-- Title -->
    <h2 class="text-2xl md:text-3xl font-semibold text-cyan-400">
      <%= post.title %>
    </h2>

    <!-- HTML-removed excerpt -->
    <p class="text-gray-300 leading-relaxed">
      <%= post.content.replace(/<[^>]*>/g, '').substring(0, 250) %>...
    </p>

    <!-- Read More -->
    <a href="/api/blog/<%= post.slug %>">
      <button class="mt-4 px-6 py-2 bg-cyan-600 text-white text-sm font-medium 
                     rounded-md hover:bg-cyan-500 transition">
        Read more →
      </button>
    </a>

  </div>

  <!-- Right: Image -->
  <div class="flex-shrink-0 mx-auto md:mx-0">
    <img
      src="<%= post.blogImage || '/assets/fallback.jpeg' %>"
      alt="<%= post.title %>"
      class="w-[300px] h-[200px] md:w-[380px] md:h-[360px] 
             object-cover rounded-lg shadow-md"
      onerror="this.onerror=null; this.src='/images/fallback.jpg';"
    />
  </div>

</div>
